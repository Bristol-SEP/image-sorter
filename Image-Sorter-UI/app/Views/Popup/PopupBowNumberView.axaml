<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:app.ViewModels.Interfaces.Popup"
             xmlns:style="clr-namespace:app.Styles"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:IPopupBowNumberViewModel"
             x:Class="app.Views.Popup.PopupBowNumberView">
    <StackPanel>
        <style:PopupCommand Text="Bow Number" IsFeaturePage="True" DataContext="{Binding}"/>
    </StackPanel>
</UserControl>
