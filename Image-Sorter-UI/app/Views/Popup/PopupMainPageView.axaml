<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:style="clr-namespace:app.Styles"
             xmlns:vm="clr-namespace:app.ViewModels.Interfaces.Popup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:IPopupMainPageViewModel"
             x:Class="app.Views.Popup.PopupMainPageView">
    <StackPanel>
        <style:PopupCommand Text="Main Page" IsFeaturePage="False"/>
        <ItemsControl ItemsSource="{Binding FeatureGroup}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}" Classes="baseButton"
                            Command="{Binding $parent[ItemsControl].((vm:IPopupMainPageViewModel)DataContext).ChooseFeature, FallbackValue={Binding}}"
                            CommandParameter="{Binding View}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>